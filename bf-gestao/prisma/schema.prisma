// BF Gestão — schema completo (todos os módulos), implementação por etapas.
// Fase 0/1/2 (Fundação, Clientes, Tarefas) têm modelagem completa.
// Fase 3+ (Certidões, Certificados, Contratos, Financeiro) têm modelagem inicial,
// a ser detalhada quando cada fase for implementada.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Fundação ----------

enum UserRole {
  ADMIN
  COLABORADOR
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users              User[]
  clientResponsibles ClientResponsible[]
  taskTemplates      TaskTemplate[]
  tasks              Task[]

  @@map("departments")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  cpf          String?   @unique
  birthDate    DateTime?
  passwordHash String
  role         UserRole  @default(COLABORADOR)
  departmentId String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department               Department?         @relation(fields: [departmentId], references: [id])
  clientResponsibles       ClientResponsible[]
  assignedTasks            Task[]              @relation("TaskResponsible")
  completedTasks           Task[]              @relation("TaskCompletedBy")
  taskHistoryEntries       TaskHistory[]
  checkedChecklistItems    TaskChecklistItem[]
  certidoesResponsible     Certidao[]
  certificados             Certificado[]       @relation("CertificadoOwner")
  certificadosResp         Certificado[]       @relation("CertificadoResponsible")
  defaultResponsibleForTemplates TaskTemplate[]

  @@map("users")
}

// ---------- Empresas do grupo (BF) ----------
// Cadastro das empresas do próprio escritório (não confundir com Client, que são os
// clientes atendidos) — hoje BF Serviços Contábeis (BR) e a entidade dos EUA. Serve pra
// consulta/referência; sem sócios ou financeiro por enquanto.

enum EmpresaTaxIdType {
  CNPJ
  EIN
}

model Empresa {
  id                 String           @id @default(cuid())
  name               String
  tradeName          String?
  country            String           @default("BR")
  taxIdType          EmpresaTaxIdType @default(CNPJ)
  taxId              String?          @unique
  inscricaoMunicipal String?
  inscricaoEstadual  String?
  taxRegime          String?
  openingDate        DateTime?
  addressLine1       String?
  addressLine2       String?
  city               String?
  stateProvince      String?
  postalCode         String?
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  clients Client[]

  @@map("empresas")
}

// ---------- Clientes ----------

enum ClientStatus {
  ATIVO
  INATIVO
  SUSPENSO
}

enum ClientPersonType {
  PF
  PJ
}

model Client {
  id                 String           @id @default(cuid())
  name               String
  personType         ClientPersonType @default(PJ)
  cnpj               String?          @unique
  cpf                String?          @unique
  tradeName          String?
  tipoAtividade      String?
  taxRegime          String?
  inscricaoMunicipal String?
  inscricaoEstadual  String?
  status             ClientStatus     @default(ATIVO)
  openingDate        DateTime?
  country            String           @default("BR")
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  uf                 String?
  municipio          String?
  // Qual empresa do grupo BF atende este cliente — opcional porque a base existente
  // (importada antes desse cadastro existir) ainda não tem isso atribuído.
  empresaId          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  empresa           Empresa?             @relation(fields: [empresaId], references: [id])
  modules           ClientModule[]
  responsibles      ClientResponsible[]
  taskTemplateLinks ClientTaskTemplate[]
  tasks             Task[]
  certidoes         Certidao[]
  certificados      Certificado[]
  contratos         Contrato[]
  receivables       ClientReceivable[]
  partners          ClientPartner[]
  activities        ClientActivity[]

  @@index([empresaId])
  @@map("clients")
}

model ClientPartner {
  id               String   @id @default(cuid())
  clientId         String
  name             String
  cpf              String?
  ownershipPercent Decimal? @db.Decimal(5, 2)
  qualification    String?
  createdAt        DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_partners")
}

model ClientActivity {
  id          String  @id @default(cuid())
  clientId    String
  code        String
  description String
  isPrimary   Boolean @default(false)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_activities")
}

enum ServiceModule {
  FISCAL
  PESSOAL
  CONTABIL
  SOCIETARIO
  FINANCEIRO
  LEGAL
}

model ClientModule {
  id        String        @id @default(cuid())
  clientId  String
  module    ServiceModule
  active    Boolean       @default(true)
  startDate DateTime      @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, module])
  @@map("client_modules")
}

model ClientResponsible {
  id           String  @id @default(cuid())
  clientId     String
  userId       String
  departmentId String?
  role         String

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([clientId, userId, role])
  @@map("client_responsibles")
}

// ---------- Tarefas (foco principal) ----------

enum Periodicity {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMESTER
  YEARLY
  PONTUAL
}

enum BusinessDayAdjustment {
  NONE
  ANTECIPATE
  POSTPONE
}

model TaskTemplate {
  id                     String                @id @default(cuid())
  name                   String
  departmentId           String
  periodicity            Periodicity
  // Regra estruturada (JSON), nunca texto livre — ex.: { "type": "dayOfMonth", "day": 20, "monthOffset": 1 }
  legalDeadlineRule      Json
  // Deslocamento, em meses, entre o mês em que a tarefa é gerada e o mês da competência
  // gerada — ex.: DAS gerado em julho aponta pra competência de junho, então -1.
  competenciaOffsetMonths Int                  @default(0)
  metaDeadlineOffsetDays Int                   @default(0)
  businessDayAdjustment  BusinessDayAdjustment @default(POSTPONE)
  geraMulta              Boolean               @default(false)
  active                 Boolean               @default(true)
  defaultResponsibleId   String?
  createdAt              DateTime              @default(now())

  department        Department              @relation(fields: [departmentId], references: [id])
  defaultResponsible User?                   @relation(fields: [defaultResponsibleId], references: [id])
  clientLinks        ClientTaskTemplate[]
  tasks              Task[]
  generationItems    TaskGenerationRunItem[]
  checklistItems      TaskTemplateChecklistItem[]

  @@map("task_templates")
}

// Modelo do checklist, definido manualmente no cadastro da tarefa recorrente. Editar
// aqui só vale para as tarefas geradas dali pra frente — cada Task copia esses itens
// pra TaskChecklistItem no momento da geração (ver generateTasks), então tarefas já
// criadas nunca são afetadas por uma mudança posterior no template.
model TaskTemplateChecklistItem {
  id             String   @id @default(cuid())
  taskTemplateId String
  text           String
  required       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  taskTemplate TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)

  @@map("task_template_checklist_items")
}

model ClientTaskTemplate {
  id             String    @id @default(cuid())
  clientId       String
  taskTemplateId String
  active         Boolean   @default(true)
  vigenciaInicio DateTime  @default(now())
  vigenciaFim    DateTime?

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taskTemplate TaskTemplate @relation(fields: [taskTemplateId], references: [id])

  @@unique([clientId, taskTemplateId])
  @@map("client_task_templates")
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
  DESCONSIDERADA
}

model Task {
  id                String     @id @default(cuid())
  clientId          String
  taskTemplateId    String?
  // Presente em toda tarefa (recorrente ou pontual) — nas recorrentes é copiado do
  // template na geração; nas pontuais é escolhido no cadastro. Fonte única, nunca lido
  // via taskTemplate.department.
  departmentId      String?
  title             String
  // Chave canônica derivada de (periodicidade, competenciaInicio) — nunca do prazo.
  competenciaKey    String
  competenciaInicio DateTime
  competenciaFim    DateTime
  prazoLegal        DateTime
  prazoMeta         DateTime
  status            TaskStatus @default(PENDENTE)
  responsibleUserId String?
  priority          Int?
  notes             String?
  // Anexo de tarefas pontuais (pdf, imagem, planilha ou txt) — mesmo padrão de
  // src/lib/file-storage.ts usado pelos certificados.
  arquivoUrl          String?
  arquivoNomeOriginal String?
  completedAt       DateTime?
  completedById     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taskTemplate    TaskTemplate? @relation(fields: [taskTemplateId], references: [id])
  department      Department?   @relation(fields: [departmentId], references: [id])
  responsibleUser User?         @relation("TaskResponsible", fields: [responsibleUserId], references: [id])
  completedBy     User?         @relation("TaskCompletedBy", fields: [completedById], references: [id])
  history         TaskHistory[]
  checklistItems  TaskChecklistItem[]

  // Garante idempotência da geração automática — nunca duplica a mesma competência
  // para o mesmo vínculo cliente+template.
  @@unique([clientId, taskTemplateId, competenciaKey])
  @@index([status])
  @@index([prazoLegal])
  @@map("tasks")
}

// Cópia, por tarefa, dos itens de TaskTemplateChecklistItem no momento da geração —
// cada Task tem seu próprio progresso, independente de outras tarefas do mesmo template.
model TaskChecklistItem {
  id          String    @id @default(cuid())
  taskId      String
  text        String
  required    Boolean   @default(false)
  order       Int       @default(0)
  checked     Boolean   @default(false)
  checkedAt   DateTime?
  checkedById String?

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checkedBy User? @relation(fields: [checkedById], references: [id])

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskHistory {
  id        String      @id @default(cuid())
  taskId    String
  userId    String?
  action    String
  oldStatus TaskStatus?
  newStatus TaskStatus?
  comment   String?
  createdAt DateTime    @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@map("task_history")
}

enum GenerationTrigger {
  CRON
  MANUAL
}

enum GenerationStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model TaskGenerationRun {
  id           String            @id @default(cuid())
  runDate      DateTime          @default(now())
  triggeredBy  GenerationTrigger
  status       GenerationStatus  @default(RUNNING)
  createdCount Int               @default(0)
  skippedCount Int               @default(0)
  errorCount   Int               @default(0)
  startedAt    DateTime          @default(now())
  finishedAt   DateTime?

  items TaskGenerationRunItem[]

  @@map("task_generation_runs")
}

enum RunItemResult {
  CREATED
  SKIPPED
  ERROR
}

model TaskGenerationRunItem {
  id             String        @id @default(cuid())
  runId          String
  clientId       String
  taskTemplateId String
  competenciaKey String
  result         RunItemResult
  errorMessage   String?

  run          TaskGenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskTemplate TaskTemplate      @relation(fields: [taskTemplateId], references: [id])

  @@map("task_generation_run_items")
}

enum HolidayScope {
  NACIONAL
  ESTADUAL
  MUNICIPAL
}

model Holiday {
  id        String       @id @default(cuid())
  date      DateTime
  name      String
  scope     HolidayScope @default(NACIONAL)
  uf        String?
  municipio String?

  @@unique([date, scope, uf, municipio])
  @@map("holidays")
}

// ---------- Certidões e Certificados (esboço — detalhar na Fase 3) ----------

enum CertidaoTipo {
  FEDERAL
  ESTADUAL
  MUNICIPAL
  FGTS
  TRABALHISTA
}

model Certidao {
  id                String       @id @default(cuid())
  clientId          String
  tipo              CertidaoTipo
  dataEmissao       DateTime?
  dataValidade      DateTime
  arquivoUrl        String?
  responsibleUserId String?
  createdAt         DateTime     @default(now())

  client          Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsibleUser User?  @relation(fields: [responsibleUserId], references: [id])

  @@map("certidoes")
}

enum CertificadoTipo {
  E_CNPJ
  E_CPF
  NFE
  OUTRO
}

model Certificado {
  id                  String          @id @default(cuid())
  clientId            String?
  ownerUserId         String?
  tipo                CertificadoTipo
  numeroSerie         String?
  dataEmissao         DateTime?
  dataValidade        DateTime
  arquivoUrl          String?
  arquivoNomeOriginal String?
  // Sempre criptografada (AES-256-GCM) — ver src/lib/crypto.ts. Nunca armazenar em texto puro.
  senhaCriptografada  String?
  responsibleUserId   String?
  createdAt           DateTime        @default(now())

  client          Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerUser       User?   @relation("CertificadoOwner", fields: [ownerUserId], references: [id])
  responsibleUser User?   @relation("CertificadoResponsible", fields: [responsibleUserId], references: [id])

  @@map("certificados")
}

// ---------- Contratos (esboço — detalhar na Fase 4) ----------

enum ContratoStatus {
  ATIVO
  ENCERRADO
  SUSPENSO
}

model Contrato {
  id             String         @id @default(cuid())
  clientId       String
  tipoServico    String
  valorMensal    Decimal        @db.Decimal(12, 2)
  dataInicio     DateTime
  vigenciaFim    DateTime?
  formaPagamento String?
  status         ContratoStatus @default(ATIVO)
  dataReajuste   DateTime?
  arquivoUrl     String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("contratos")
}

// ---------- Financeiro (esboço — detalhar na Fase 5) ----------

model ClientReceivable {
  id          String    @id @default(cuid())
  clientId    String
  competencia String?
  valor       Decimal   @db.Decimal(12, 2)
  vencimento  DateTime
  paidAt      DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_receivables")
}

model CashAccount {
  id      String  @id @default(cuid())
  name    String
  bank    String?
  balance Decimal @default(0) @db.Decimal(12, 2)

  @@map("cash_accounts")
}
